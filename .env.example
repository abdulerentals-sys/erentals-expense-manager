# Add the real connection string as a private Netlify environment variable.
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster-host>/?retryWrites=true&w=majority
MONGODB_DB_NAME=erentals_expense_manager

# Generate a random value of at least 32 characters. Never commit the real value.
AUTH_SECRET=<long-random-secret>

# Used only to create the very first administrator when the users collection is empty.
ADMIN_EMAIL=admin@example.com
ADMIN_INITIAL_PASSWORD=<temporary-password-with-letters-and-numbers>
